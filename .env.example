# NeonDB Postgres connection string
# Get this from https://console.neon.tech -> your project -> Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require


# Secret used to sign login sessions (JWT). Use any long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key — powers BOTH the in-session study assistant and the
# new agentic AI booking assistant (lib/agent.js)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Stripe Checkout for buying credits
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

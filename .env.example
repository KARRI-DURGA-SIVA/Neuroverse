# NeonDB Postgres connection string
# Get this from https://console.neon.tech -> your project -> Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require


# Secret used to sign login sessions (JWT). Use any long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key — powers BOTH the in-session study assistant and the
# new agentic AI booking assistant (lib/agent.js)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Stripe Checkout for buying credits
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay wallet top-ups (INR). Set four comma-separated INR prices in the
# same order as CREDIT_PACKS in lib/pricing.js. Configure UPI and netbanking
# in Razorpay Dashboard, then optionally set the Checkout configuration ID.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_CONFIG_ID=
RAZORPAY_CREDIT_PACK_PRICES_INR=

# Session credit pricing multipliers by learner-selected target level
SESSION_LEVEL_FACTOR_BEGINNER=0.5
SESSION_LEVEL_FACTOR_INTERMEDIATE=1
SESSION_LEVEL_FACTOR_ADVANCED=1.5
SESSION_LEVEL_FACTOR_EXPERT=2

# Zoom Server-to-Server OAuth and scheduled meetings
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_USER_ID=me

NODE_ENV=development
